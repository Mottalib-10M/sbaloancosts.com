---
/**
 * Home (pillar, RECETTE §5, §21): the question, the answer in one sentence with the example's payment, entry
 * buttons by profile, the 7(a) cost calculator prefilled with the example, the same example at the cap, the folded
 * citable block; then three reference sections and three questions (brief of 2026-11-10, five rules: one example
 * everywhere, $220,000, the median loan; the first question answered on the first screen; at most three sections and
 * three questions; every term explained where it is read). Every figure comes from the engine, the parameter file
 * or the FOIA aggregates.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './Tool.astro';
import Clamp from './Clamp.astro';
import Sources from './Sources.astro';
import { route } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { shortBank, typicalRate, EXAMPLE_AMOUNT } from '../lib/mini-specs';
import { formatNumber } from '../lib/format';
import { faqSchema, webApplicationSchema, websiteSchema, organizationSchema } from '../lib/seo';
import { SCRIPT_PLI } from '../lib/plier';
const lang = 'en';
const h = helpers(true);
const { P, E, F, m, r, pc } = h;
const N = F.national;
const T = P.fees7a.tiers;
const S = F.states;

// One example on the whole page (brief of 2026-11-10, rule 1): the median loan, over 10 years, at the typical rate.
const X = EXAMPLE_AMOUNT;
const xRate = typicalRate(X);
const ex = E.cost7a({ amount: X, years: 10, rate: xRate });
const exCap = E.cost7a({ amount: X, years: 10, rate: E.maxRate(X, 'variable') });
const saved = exCap.interest - ex.interest;
const xBand = E.bandOf(X);
// Worked borrowers of the third section: each hypothesis named in bold before its figure.
const b = E.cost7a({ amount: 350000, years: 10, rate: typicalRate(350000) });
const bW = E.cost7a({ amount: 350000, years: 10, rate: typicalRate(350000), waiver: true });
const c = E.cost7a({ amount: 1_200_000, years: 25, rate: typicalRate(1_200_000) });
const c504 = E.cost504({ project: 1_333_000, debentureRate: P.prime.rate, bankRate: typicalRate(1_200_000) });

const per100 = (x: number) => `${Math.round(x * 100)} in 100`;
const bandRows = E.BAND_LABELS.map((lab, i) => [lab, h.num(N.rates.V[i].n), `prime + ${formatNumber(E.maxSpread([50000, 250000, 350000, 1e6][i], 'variable'), 1)}`, `prime + ${formatNumber(N.medSpreadVBand[i]!, 2)}`, per100(N.atCapVBand[i]!), r(E.maxRate([50000, 250000, 350000, 1e6][i], 'variable')), r(E.round2(P.prime.rate + N.medSpreadVBand[i]!))]);
const progRows = [
  [`<a href="${route('sba-7a-loan', lang)}">Standard 7(a)</a>`, m(P.sevenA.maxLoan), `${P.sevenA.guaranty.smallPct}% / ${P.sevenA.guaranty.largePct}%`, `${T[0].rate}% to ${T[2].rateOver1M}% of the guaranteed part`, `cap: prime + ${formatNumber(E.maxSpread(1e6, 'variable'), 0)} to ${formatNumber(E.maxSpread(1, 'variable'), 1)} (variable)`, h.num(N.programs.plp + N.programs.general + N.programs.other)],
  [`<a href="${route('sba-express-loan', lang)}">SBA Express</a>`, m(P.sevenA.expressMax), `${P.sevenA.guaranty.expressPct}%`, `same schedule, on a ${P.sevenA.guaranty.expressPct}% guaranty; $0 for veterans`, 'same cap as 7(a)', h.num(N.programs.express)],
  [`<a href="${route('sba-504-loan', lang)}">504 (buildings)</a>`, `${m(P.fees504.maxDebenture)} from the CDC (a nonprofit lender approved by SBA)`, 'the CDC’s loan, fully backed by SBA', `${formatNumber(P.fees504.upfront, 2)}% + ${formatNumber(P.fees504.annual, 3)}% a year, plus CDC fees`, 'fixed, set when SBA sells the loans', h.num(N.f504!.n)],
  [`<a href="${route('sba-microloan', lang)}">Microloan</a>`, m(P.micro.max), 'none: SBA lends to a nonprofit lender', 'no SBA fee; the lender’s fees vary', `the lender’s own SBA rate + ${formatNumber(P.micro.spreadLarge, 2)} to ${formatNumber(P.micro.spreadSmall, 2)} points`, 'not published'],
];
const capHi = [...N.lenders].filter((l) => l.atCapV !== null).sort((x, y) => y.atCapV! - x.atCapV!).slice(0, 2);
const lowX = [...N.lenders].filter((l) => l.medVBand[xBand] !== null).sort((x, y) => x.medVBand[xBand]! - y.medVBand[xBand]!);
const stLocal = Object.values(S).sort((x, y) => y.localLenderShare - x.localLenderShare);
const stMed = Object.values(S).sort((x, y) => y.medAmt - x.medAmt);

const resume = `An SBA 7(a) loan costs three things: a one-time guaranty fee, interest at a rate the lender chooses under the SBA cap (the highest rate SBA allows), and the length of the term, which sets how long that interest runs. Few borrowers pay the cap. In SBA’s own file of the ${h.num(N.n)} loans approved ${h.fy}, the median variable rate was ${r(N.medV!)}, and ${pc(N.atCapV!)} of variable loans sat at the cap, most of them small loans. With prime at ${r(P.prime.rate)} on ${h.date(P.prime.date)}, the variable cap runs from ${r(E.maxRate(1e6, 'variable'))} on large loans to ${r(E.maxRate(1, 'variable'))} on the smallest. For loans approved from ${h.date(P.fy.from)} to ${h.date(P.fy.to)}, the fee is ${T[0].rate}% of the guaranteed part on loans of ${m(T[0].upTo)} or less, ${T[1].rate}% up to ${m(T[1].upTo)} and ${T[2].rate}% to ${T[2].rateOver1M}% above; manufacturers, food supply chain businesses and rural businesses pay nothing up to ${m(P.fees7a.waiver.upTo)}. The calculator above starts from the typical margin for your loan size, applied to today’s prime.`;

// Brief of 2026-11-10, rule 3 asks three questions a page; the pillar page must carry six (check-trame, RECETTE):
// six short ones, the three most asked open, all on the page's own example.
const faqs = [
  { q: 'How much does an SBA loan cost per month?', a: `It depends on the amount, the rate and the term. On the example of this page, ${m(X)} over 10 years at the typical rate for that size, ${r(xRate)}, the payment is ${m(ex.monthly)} a month, with the ${m(ex.fee.fee)} guaranty fee added to the loan. A real estate loan over 25 years pays less each month but more interest overall.` },
  { q: 'What credit score is needed for an SBA loan?', a: 'SBA sets no minimum personal credit score for 7(a) loans in its rules; the lender judges credit, cash flow and collateral under its own policy and SBA’s standards. A lender may also use a business credit score, if it uses the same model for its own similar loans. A strong score mainly helps on price: it gives you room to ask for a margin, the add-on above prime, below the cap.' },
  { q: 'How long does it take to get an SBA loan?', a: 'From application to funding it usually takes several weeks, longer when real estate or a business purchase is involved, because of appraisals, valuations and title work. Lenders that SBA lets approve loans on their own, and SBA Express loans, skip SBA’s own credit review, which saves time. The rate is set off the prime of the first business day of the month, so the timing of approval can change the number slightly.' },
  { q: 'Is the SBA rate the same at every bank?', a: `No. SBA sets only the cap, the highest rate allowed. On loans of ${E.BAND_LABELS[xBand]}, the size of the ${m(X)} example, the typical rate ran from ${r(lowX[0].medVBand[xBand]!)} to ${r(lowX[lowX.length - 1].medVBand[xBand]!)} among the busiest SBA lenders approved ${h.fy}, for the same cap and the same prime. Two quotes for the same loan can differ by several points.` },
  { q: 'Can a new business get an SBA loan?', a: `Yes: ${h.num(N.ages.startup)} of the ${h.num(N.n)} SBA 7(a) loans approved ${h.fy} went to businesses not yet open. Expect to bring a business plan and cash of your own, at least ${P.sevenA.startupEquity}% of the total project cost, and to sign a personal guarantee if you own 20% or more.` },
  { q: 'Does the calculator include closing costs?', a: 'It includes SBA’s guaranty fee, added to the loan, and every payment of interest. It leaves out what varies by lender and by deal: packaging or third-party report fees, appraisals, title and recording costs. Ask each lender for a written list of them with the quote.' },
];
const jsonLd = [webApplicationSchema({ name: 'SBA loan cost calculator', description: 'Guaranty fee, maximum rate, payment and total cost of an SBA 7(a) loan on today’s prime, with the rate set against the loans SBA approved last year.', path: route('home', lang), lang }), websiteSchema(lang), organizationSchema(lang), faqSchema(faqs, lang)];
const recoup = P.sevenA.recoupment.byYear.map((x) => `${x}%`).join(', ');
// Entry buttons by profile (brief of 2026-11-10, rule 2): buttons, not a third link lost in a line.
const doors = [
  [route('sba-loan-rates', lang), 'My bank quoted a rate: is it fair?'],
  [`${route('sba-7a-loan', lang)}#requirements`, 'Can my business get one?'],
  [route('sba-guaranty-fee', lang), 'Manufacturer, farm or rural: $0 fee?'],
  [route('sba-vs-conventional-loan', lang), 'SBA or a plain bank loan?'],
];
---
<PageLayout title={`SBA Loan Calculator 2026: Fee, Rate Cap, Payment, Total Cost`} description={`SBA loan calculator: the FY 2027 guaranty fee, the legal rate cap on today’s prime, your monthly payment and total cost, set against ${h.num(N.n)} real SBA loans.`} lang={lang} jsonLd={jsonLd} faqs={faqs.map((f, i) => ({ ...f, open: i < 3 }))}>
  <header class="mb-3">
    <h1 class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">SBA loan calculator: what your loan costs, and what others really paid</h1>
    {/* Brief of 2026-11-10, rule 2: the answer announced on the first screen, on the page's one example. */}
    <p class="mt-2 text-base text-navy-700 sm:text-lg">An SBA loan is a business loan from your bank, partly guaranteed by the SBA (the U.S. Small Business Administration, a federal agency). Example: <strong>{m(X)} over 10 years at {r(xRate)} is {m(ex.monthly)} a month</strong>, SBA fee included. Type your own figures below.</p>
    <p class="mt-1 text-sm text-navy-700">Independent site, not a lender, not the SBA. Nothing you type leaves your phone: no sign-up, no lender will call you.</p>
  </header>
  <nav aria-label="Start from your situation" class="mb-4">
    <p class="mb-1 text-sm font-semibold text-navy-900">Your question:</p>
    <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      {doors.map(([href, txt]) => <li><a href={href} class="flex min-h-[44px] items-center rounded-lg border border-accent-300 bg-accent-50 px-3 py-1.5 text-sm font-medium leading-tight text-accent-800 hover:bg-accent-100">{txt}</a></li>)}
    </ul>
  </nav>
  <div id="calc" data-outil class="mb-4 scroll-mt-20"><Tool tool={{ kind: 'mini:cost' }} primary={true} /></div>
  {/* The strongest message, on the same example as the calculator (naive test of 2026-11-10: $40,000 then $350,000 lost the reader). */}
  <div class="callout callout-example !mt-0 !mb-4">
    <span class="callout-title">Same {m(X)} loan over 10 years, two banks</span>
    <p>At the SBA cap for this size, {r(exCap.maxRate)}: {m(exCap.monthly)} a month. At the typical rate, {r(xRate)}: {m(ex.monthly)} a month. A second quote at the typical rate saves {m(saved)} of interest.</p>
  </div>
  <p class="mb-4 text-sm text-navy-800"><strong>Same loan, different banks:</strong> on loans of {E.BAND_LABELS[xBand]}, the typical rate ran from {r(lowX[0].medVBand[xBand]!)} to {r(lowX[lowX.length - 1].medVBand[xBand]!)} among the busiest SBA lenders. Get two quotes: see the <a href={route('sba-lenders', lang)} class="underline hover:text-navy-900">top SBA lenders</a> or the <a href={route('sba-loans-by-state', lang)} class="underline hover:text-navy-900">lenders in your state</a>.</p>
  <Clamp text={resume} id="clamp-home" lang={lang} label="Show the whole paragraph" class="mb-6" />

  <p class="pli-aide" data-chrome>Details, data and worked examples: tap a heading to open it.</p>
  <div class="prose prose-slate max-w-none">
    <details class="pli"><summary><h2>The four numbers to ask your bank for</h2></summary><div class="pli-corps">
    <p><strong>The SBA fee.</strong> SBA charges it once, on the part of the loan it guarantees, and nearly every lender adds it to the loan. On the {m(X)} example it is {m(ex.fee.fee)}. Since {h.date(P.fy.from)}, manufacturers, farms, the food suppliers on SBA’s list and businesses in a rural area pay nothing on loans up to {m(P.fees7a.waiver.upTo)}. The <a href={route('sba-guaranty-fee', lang)}>guaranty fee page</a> gives the whole schedule.</p>
    <p><strong>The margin over prime.</strong> Prime is the base rate banks lend from, {r(P.prime.rate)} today. A variable SBA rate is prime plus a margin, an add-on written into the loan contract for its whole life. SBA caps that margin by loan size, from {formatNumber(E.maxSpread(1, 'variable'), 1)} points on the smallest loans to {formatNumber(E.maxSpread(1e6, 'variable'), 1)} on the largest (a point is one percentage point). Fixed rates have their own cap.</p>
    <p><strong>The term.</strong> Ten years is the usual limit for equipment and working capital, twenty-five for real estate. The term matters as much as the rate: a longer loan has a lower payment and more interest.</p>
    <p><strong>The prime rate itself.</strong> Every variable SBA loan follows it, so the same margin costs a quarter point more or less depending on the month. Prime moved four times since September 2025; the <a href={route('sba-loan-rates', lang)}>rates page</a> lists the dates.</p>
    <p><strong>What the calculator leaves out.</strong> It holds your rate constant and does not forecast prime: if prime rises a point, a variable payment rises with it. It leaves out lender fees that SBA allows within limits, such as packaging fees, and third-party costs such as appraisals, title insurance and recording, because they vary by deal; ask each lender to list them in writing. It assumes the fee is added to the loan, as most lenders do, and that the loan runs to term; repaid early, a loan of 15 years or more pays SBA’s <a href={route('sba-prepayment-penalty', lang)}>prepayment fee</a> of {recoup} in its first three years. Nor does it tell you whether you qualify: the lender decides, under SBA’s rules. Everything is worked out in your browser, and nothing is passed to any lender.</p>
    </div></details>

    <details class="pli"><summary><h2 id="data-title">What real SBA loans cost, by size</h2></summary><div class="pli-corps">
    <p>Lenders and comparison sites quote the cap, or a range that stops at it. SBA publishes something more useful: every loan it guaranteed, with its amount, rate, term and lender. Counted for loans approved {h.fy}, it shows how far real pricing sits from the cap, by size. The margin is the part of the rate above prime; “typical” means the median: half of borrowers paid less, half more. The last column, “Typical rate today”, puts that margin on today’s prime: it is the rate the calculator starts from.</p>
    <Fragment set:html={h.table(['Loan size', 'Variable-rate loans counted', 'SBA cap', 'Typical margin paid', 'Priced at the cap', 'SBA cap today', 'Typical rate today'], bandRows.map((x) => [x[0], x[1], x[2], x[3], x[4], x[6], x[7]]), `SBA’s public loan file, variable-rate loans approved ${h.fy}. Margin = rate at approval minus the prime rate of that month. Today: prime ${r(P.prime.rate)} of ${h.date(P.prime.date)}.`, ['l', 'r', 'l', 'r', 'r', 'r', 'r'])} />
    <p>First, the smallest loans are the most often priced at the cap: {per100(N.atCapVBand[0]!)} loans of {m(50000)} or less, against {per100(N.atCapVBand[1]!)} just above. A small borrower has the most to gain from a second quote.</p>
    <p>Second, the lender matters more than the program. {shortBank(capHi[0].name)} priced {pc(capHi[0].atCapV!)} of its variable loans at the cap and {shortBank(capHi[1].name)} {pc(capHi[1].atCapV!)}, while several of the largest SBA lenders almost never did. The <a href={route('sba-lenders', lang)}>lender page</a> has the 25 busiest.</p>
    <p>Third, markets differ by state. {stLocal[0].name} borrowers got {pc(stLocal[0].localLenderShare)} of their loans from in-state lenders, {stLocal[stLocal.length - 1].name} borrowers {pc(stLocal[stLocal.length - 1].localLenderShare)}. The middle-sized loan ran from {m(stMed[stMed.length - 1].medAmt)} in {stMed[stMed.length - 1].name} to {m(stMed[0].medAmt)} in {stMed[0].name}. Each state has its own page under <a href={route('sba-loans-by-state', lang)}>SBA loans by state</a>. No borrower is named anywhere on this site; the counts are totals, and groups of fewer than {F.minCell} loans are not shown.</p>
    </div></details>

    <details class="pli"><summary><h2 id="prog-title">Which SBA loan fits: four programs, three borrowers</h2></summary><div class="pli-corps">
    <Fragment set:html={h.table(['Program', 'Maximum', 'SBA guaranty', 'SBA fee', 'Rate', `Approvals, ${h.fy}`], progRows, `Standard 7(a) counts every 7(a) loan other than Express, so the two add up to the ${h.num(N.n)} approvals. Microloan counts are not in SBA’s public loan file. The SBA notices and rules behind each line are listed under Sources.`, ['l', 'r', 'l', 'l', 'l', 'r'])} />
    <p><strong>Borrowing {m(P.sevenA.expressMax)} or less?</strong> Ask about <a href={route('sba-express-loan', lang)}>SBA Express</a>: the lender decides on its own, the SBA cap is the same, and the SBA fee is charged on half the loan.</p>
    <p><strong>Buying an existing business?</strong> A 7(a) loan can pay for it: {h.num(N.ages.buyout)} of the {h.num(N.n)} SBA 7(a) loans approved {h.fy} did. Choose 10 years, unless real estate is most of the price, and ask the lender how much cash of your own it wants.</p>
    <p><strong>A machine shop borrowing {m(350000)} for equipment over 10 years.</strong> A machine shop is a manufacturer in SBA’s sense, so it pays no guaranty fee: {m(bW.monthly)} a month at {r(typicalRate(350000))}. A business outside the relief pays the {m(b.fee.fee)} fee and {m(b.monthly)} a month.</p>
    <p><strong>A dental practice buying its building for {m(1_200_000)} over 25 years.</strong> As a 7(a) loan at {r(typicalRate(1_200_000))}, the fee is {m(c.fee.fee)} and the payment {m(c.monthly)} a month. As a <a href={route('sba-504-loan', lang)}>504 project</a> of about {m(1_333_000)} with 10% down, the CDC’s share carries {m(c504.gross - c504.net)} of fees, but its fixed rate removes the risk of prime rising.</p>
    </div></details>
  </div>

  <div class="prose prose-slate mt-8 max-w-none">
    <Sources lang={lang} intro="Each fee, rate cap and loan count on this page comes from the SBA notices, federal rules and SBA loan files listed below, read on" />
  </div>
  <script is:inline set:html={SCRIPT_PLI} />
</PageLayout>
