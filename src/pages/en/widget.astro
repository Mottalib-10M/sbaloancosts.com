---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/sba-loan-cost-calculator/" title="SBA loan cost calculator" width="100%" height="720" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the SBA loan cost calculator on your site for free" description="Show the SBA loan cost calculator on your own site for free: one iframe, the FY 2027 guaranty fee, the rate cap on today’s prime and the payment, with no sign-up." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the SBA loan cost calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a small business development center, a chamber of commerce or an article on business financing: visitors type an amount, a term and a rate, and see the SBA fee, the legal maximum, the payment and the total cost.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit and source lines under the calculator visible and use it as it is, without warranty. When SBA publishes a new fee notice or prime changes and the site is rebuilt, the embedded calculator follows.</p>
    <p>Nothing your visitors type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/sba-loan-cost-calculator/" title="SBA loan cost calculator" width="100%" height="720" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
